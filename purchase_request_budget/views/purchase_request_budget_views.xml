<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHIER : views/purchase_request_budget_views.xml
    RÔLE    : Écrans des budgets de département (liste, formulaire, recherche, action).
              Seule la Direction peut les modifier (voir ir.model.access.csv) ;
              les autres groupes les voient en lecture seule.
-->
<odoo>

    <record id="purchase_request_budget_view_list" model="ir.ui.view">
        <field name="name">purchase.request.budget.list</field>
        <field name="model">purchase.request.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets">
                <field name="department_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_allocated"/>
                <field name="amount_committed"/>
                <!-- Montant restant en rouge s'il est négatif -->
                <field name="amount_remaining" decoration-danger="amount_remaining &lt; 0"/>
            </list>
        </field>
    </record>

    <record id="purchase_request_budget_view_form" model="ir.ui.view">
        <field name="name">purchase.request.budget.form</field>
        <field name="model">purchase.request.budget</field>
        <field name="arch" type="xml">
            <form string="Budget de département">
                <sheet>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_allocated"/>
                            <field name="amount_committed"/>
                            <field name="amount_remaining"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_request_budget_view_search" model="ir.ui.view">
        <field name="name">purchase.request.budget.search</field>
        <field name="model">purchase.request.budget</field>
        <field name="arch" type="xml">
            <search string="Rechercher un budget">
                <field name="department_id"/>
                <filter name="date_start" string="Date de début" date="date_start"/>
                <filter name="group_department" string="Département" context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>

    <record id="purchase_request_budget_action" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">purchase.request.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez le budget d'un département</p>
            <p>Sans budget couvrant la date de la demande, une demande d'achat ne peut pas être soumise.</p>
        </field>
    </record>

</odoo>
