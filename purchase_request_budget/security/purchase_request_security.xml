<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHIER : security/purchase_request_security.xml
    RÔLE    : Groupes d'utilisateurs et règles de visibilité (§2 du cahier des charges).

    Deux mécanismes de sécurité complémentaires dans Odoo :
      1. Les DROITS D'ACCÈS (fichier ir.model.access.csv) : un groupe peut-il
         lire / écrire / créer / supprimer des enregistrements d'un modèle ?
      2. Les RÈGLES D'ENREGISTREMENT (ir.rule, dans ce fichier) : parmi ces
         enregistrements, LESQUELS le groupe a-t-il le droit de voir ?
         Exemple : un demandeur a le droit de lire des demandes, mais
         uniquement les siennes.

    Quand un utilisateur est dans plusieurs groupes, Odoo additionne (OU)
    les règles de ses groupes : un manager voit ses propres demandes
    (règle Demandeur) ET celles de son département (règle Manager).
-->
<odoo>

    <!-- ================================================================
         « Privilège » : regroupe nos 3 groupes sous un seul menu
         déroulant dans la fiche utilisateur (Paramètres > Utilisateurs).
         ================================================================ -->
    <record id="res_groups_privilege_purchase_request" model="res.groups.privilege">
        <field name="name">Demandes d'achat internes</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- ================================================================
         GROUPES HIÉRARCHIQUES : Direction hérite de Manager, qui hérite
         de Demandeur. implied_ids = « faire partie de ce groupe donne
         aussi les droits du groupe indiqué ».
         ================================================================ -->

    <record id="group_purchase_request_user" model="res.groups">
        <field name="name">Demandeur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <!-- base.group_user = « Utilisateur interne » (employé de l'entreprise) -->
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_purchase_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="implied_ids" eval="[Command.link(ref('group_purchase_request_user'))]"/>
    </record>

    <record id="group_purchase_request_director" model="res.groups">
        <field name="name">Direction</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="implied_ids" eval="[Command.link(ref('group_purchase_request_manager'))]"/>
        <!-- L'administrateur est placé dans la Direction pour pouvoir tout gérer. -->
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- ================================================================
         RÈGLES SUR LES DEMANDES D'ACHAT (purchase.request)
         domain_force = filtre appliqué automatiquement à toutes les lectures.
         Variables disponibles : user (utilisateur connecté),
         company_ids (sociétés actives de l'utilisateur).
         ================================================================ -->

    <!-- Règle GLOBALE (sans groupe) : s'applique à tout le monde.
         Multi-sociétés : on ne voit que les demandes des sociétés actives. -->
    <record id="purchase_request_rule_multi_company" model="ir.rule">
        <field name="name">Demande d'achat : multi-sociétés</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Demandeur : uniquement ses propres demandes.
         Cette règle s'applique aussi à la création : un demandeur ne peut
         donc pas créer une demande au nom d'un autre employé. -->
    <record id="purchase_request_rule_user" model="ir.rule">
        <field name="name">Demande d'achat : le demandeur voit ses demandes</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_purchase_request_user'))]"/>
    </record>

    <!-- Manager : les demandes des départements dont il est le manager. -->
    <record id="purchase_request_rule_manager" model="ir.rule">
        <field name="name">Demande d'achat : le manager voit son département</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_purchase_request_manager'))]"/>
    </record>

    <!-- Direction : toutes les demandes. [(1, '=', 1)] est une condition toujours vraie. -->
    <record id="purchase_request_rule_director" model="ir.rule">
        <field name="name">Demande d'achat : la Direction voit tout</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_purchase_request_director'))]"/>
    </record>

    <!-- Acheteur (groupe standard « Achats / Utilisateur ») : les demandes
         validées ou converties. Lecture + écriture (pour passer la demande
         à « Convertie »), sans création ni suppression. -->
    <record id="purchase_request_rule_purchase_user" model="ir.rule">
        <field name="name">Demande d'achat : l'acheteur voit les demandes validées</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="domain_force">[('state', 'in', ('validated', 'converted'))]</field>
        <field name="groups" eval="[Command.link(ref('purchase.group_purchase_user'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ================================================================
         RÈGLES SUR LES LIGNES (purchase.request.line) : mêmes principes,
         en passant par la demande parente (request_id).
         ================================================================ -->

    <record id="purchase_request_line_rule_multi_company" model="ir.rule">
        <field name="name">Ligne de demande d'achat : multi-sociétés</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="purchase_request_line_rule_user" model="ir.rule">
        <field name="name">Ligne de demande d'achat : demandeur</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_purchase_request_user'))]"/>
    </record>

    <record id="purchase_request_line_rule_manager" model="ir.rule">
        <field name="name">Ligne de demande d'achat : manager</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="domain_force">[('request_id.department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_purchase_request_manager'))]"/>
    </record>

    <record id="purchase_request_line_rule_director" model="ir.rule">
        <field name="name">Ligne de demande d'achat : Direction</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_purchase_request_director'))]"/>
    </record>

    <record id="purchase_request_line_rule_purchase_user" model="ir.rule">
        <field name="name">Ligne de demande d'achat : acheteur</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="domain_force">[('request_id.state', 'in', ('validated', 'converted'))]</field>
        <field name="groups" eval="[Command.link(ref('purchase.group_purchase_user'))]"/>
    </record>

    <!-- ================================================================
         RÈGLE SUR LES BUDGETS : uniquement le cloisonnement multi-sociétés.
         Qui peut les modifier est géré par les droits d'accès (CSV) :
         seule la Direction peut créer / modifier / supprimer un budget.
         ================================================================ -->
    <record id="purchase_request_budget_rule_multi_company" model="ir.rule">
        <field name="name">Budget de département : multi-sociétés</field>
        <field name="model_id" ref="model_purchase_request_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
