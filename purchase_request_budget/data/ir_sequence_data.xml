<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHIER : data/ir_sequence_data.xml
    RÔLE    : Séquence qui numérote les demandes : DA/2026/0001, DA/2026/0002...

    noupdate="1" : ces données ne sont créées qu'à l'INSTALLATION. Une mise
    à jour du module ne les écrase pas, ce qui évite de remettre le compteur
    à zéro ou d'annuler une personnalisation faite par l'administrateur.
-->
<odoo>
    <data noupdate="1">

        <record id="seq_purchase_request" model="ir.sequence">
            <field name="name">Demande d'achat interne</field>
            <!-- code : clé utilisée en Python par next_by_code('purchase.request') -->
            <field name="code">purchase.request</field>
            <!-- %(year)s est remplacé par l'année en cours (ex. 2026) -->
            <field name="prefix">DA/%(year)s/</field>
            <!-- padding = nombre de chiffres : 1 devient 0001 -->
            <field name="padding">4</field>
            <!-- Pas de société : une seule numérotation pour toute la base -->
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
