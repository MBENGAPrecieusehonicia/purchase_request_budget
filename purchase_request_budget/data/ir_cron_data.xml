<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHIER : data/ir_cron_data.xml
    RÔLE    : Action planifiée (tâche automatique) exécutée une fois par jour :
              elle relance les valideurs des demandes en attente depuis
              plus de 3 jours (méthode _cron_send_validation_reminders).
              Visible en mode développeur : Paramètres > Technique > Actions planifiées.
-->
<odoo>
    <data noupdate="1">

        <record id="ir_cron_purchase_request_reminder" model="ir.cron">
            <field name="name">Demandes d'achat : relance des validations en attente</field>
            <!-- Modèle sur lequel le code s'exécute (« model » dans le code ci-dessous) -->
            <field name="model_id" ref="model_purchase_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_validation_reminders()</field>
            <!-- Fréquence : tous les 1 jour -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Exécutée avec l'utilisateur système (droits complets) -->
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
